// dracula — waybar
// Shell: Thin menubar on top, indicator dock on the bottom.
// This rice's own desktop shell, not a restyle of another profile's.
[
  {
    "name": "menubar",
    "layer": "top",
    "position": "top",
    "height": 24,
    "modules-left": [
      "custom/launcher",
      "hyprland/window"
    ],
    "modules-center": [],
    "modules-right": [
      "clock"
    ],
    "custom/launcher": {
      "format": "",
      "on-click": "rofi -show drun",
      "tooltip": false,
      "cursor": true
    },
    "hyprland/window": {
      "format": "{title}",
      "max-length": 50,
      "separate-outputs": true,
      "rewrite": {
        "": "—"
      }
    },
    "clock": {
      "interval": 10,
      "format": "{:%H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
        "mode": "month",
        "format": {
          "today": "<b>{}</b>"
        }
      }
    },
    "spacing": 5
  },
  {
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "height": 44,
    "width": 440,
    "margin-bottom": 10,
    "modules-left": [],
    "modules-center": [
      "custom/ws"
    ],
    "modules-right": [
      "pulseaudio",
      "network",
      "battery",
      "custom/notif",
      "custom/power"
    ],
    "custom/ws": {
      "exec": "~/.config/waybar/scripts/ws.py all dots",
      "on-click": "~/.config/waybar/scripts/ws.py cycle 1",
      "on-click-right": "~/.config/waybar/scripts/ws.py cycle -1",
      "on-scroll-up": "~/.config/waybar/scripts/ws.py cycle 1",
      "on-scroll-down": "~/.config/waybar/scripts/ws.py cycle -1",
      "return-type": "json",
      "restart-interval": 3,
      "cursor": true
    },
    "pulseaudio": {
      "format": "{icon} {volume}",
      "format-muted": "󰝟",
      "scroll-step": 5,
      "format-icons": {
        "headphone": "󰋋",
        "default": [
          "󰕿",
          "󰖀",
          "󰕾"
        ]
      },
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
      "interval": 5,
      "format-wifi": "{icon}",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰤮",
      "format-icons": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "tooltip-format-wifi": "<b>{essid}</b>\n{signalStrength}%  ·  {ipaddr}",
      "on-click": "alacritty --class nm-float -e nmtui"
    },
    "battery": {
      "interval": 30,
      "states": {
        "warning": 25,
        "critical": 12
      },
      "format": "{icon} {capacity}",
      "format-charging": "󰂄 {capacity}",
      "format-icons": [
        "󰁺",
        "󰁼",
        "󰁾",
        "󰂀",
        "󰂂"
      ],
      "tooltip-format": "{capacity}%  ·  {time} left"
    },
    "custom/notif": {
      "exec": "~/.config/waybar/scripts/notif.py render",
      "on-click": "~/.config/waybar/scripts/notif.py toggle",
      "return-type": "json",
      "interval": 3,
      "cursor": true
    },
    "custom/power": {
      "format": "󰐥",
      "on-click": "~/.config/waybar/scripts/power.sh",
      "tooltip": false,
      "cursor": true
    },
    "spacing": 5
  }
]
