/* dawn — rofi
 *
 * A sheet of paper. Near-opaque (light surfaces do not survive being made
 * translucent over an arbitrary wallpaper), generous rows, and a pine
 * selection that is the only dark mark on the page.
 */

configuration {
  modes:               "drun,run";
  show-icons:          true;
  icon-theme:          "breeze-dark";
  drun-display-format: "{name}";
  display-drun:        "apps";
  display-run:         "run";
  drun-match-fields:   "name,generic,exec,keywords";
}

* {
  base:    #faf4ed;
  surface: #fffaf3;
  overlay: #f2e9e1;
  hl:      #dfdad9;
  text:    #575279;
  subtle:  #797593;
  muted:   #9893a5;
  love:    #b4637a;
  gold:    #ea9d34;
  rose:    #d7827e;
  pine:    #286983;
  foam:    #56949f;
  iris:    #907aa9;

  background-color: transparent;
  text-color:       @text;
  font:             "Adwaita Sans 12";
}

window {
  width:            540px;
  background-color: #fffaf3fa;
  border:           1px;
  border-color:     @hl;
  border-radius:    16px;
  padding:          0;
}

mainbox {
  children: [ inputbar, listview ];
  spacing:  0;
}

inputbar {
  children:     [ prompt, entry ];
  padding:      16px 20px;
  spacing:      12px;
  border:       0 0 1px 0;
  border-color: @overlay;
}

prompt {
  background-color: @pine;
  text-color:       @base;
  padding:          2px 12px;
  border-radius:    9px;
}

entry {
  placeholder:       "search";
  placeholder-color: @muted;
  cursor:            text;
  text-color:        @text;
  vertical-align:    0.5;
}

listview {
  lines:        9;
  columns:      1;
  padding:      8px;
  spacing:      2px;
  scrollbar:    false;
  fixed-height: false;
}

element {
  padding:       10px 14px;
  spacing:       13px;
  border-radius: 10px;
  cursor:        pointer;
}

element normal.normal {
  background-color: transparent;
  text-color:       @subtle;
}

element alternate.normal {
  background-color: transparent;
  text-color:       @subtle;
}

element normal.active,
element alternate.active {
  background-color: transparent;
  text-color:       @foam;
}

element normal.urgent,
element alternate.urgent {
  background-color: transparent;
  text-color:       @love;
}

element selected.normal,
element selected.active {
  background-color: @pine;
  text-color:       @base;
}

element selected.urgent {
  background-color: @love;
  text-color:       @base;
}

element-icon {
  size:           21px;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color:     inherit;
}
