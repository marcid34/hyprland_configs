{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "left": 2, "right": 4 },
    "color": { "1": "38;2;109;143;99", "2": "38;2;179;138;82" }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 9 },
    "color": { "title": "38;2;109;143;99" }
  },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "38;2;109;143;99", "host": "38;2;179;138;82" } },
    { "type": "custom", "format": "  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500" },
    { "type": "os",     "key": "os",   "keyColor": "38;2;125;116;102" },
    { "type": "kernel", "key": "kern", "keyColor": "38;2;125;116;102" },
    { "type": "wm",     "key": "wm",   "keyColor": "38;2;125;116;102" },
    { "type": "shell",  "key": "sh",   "keyColor": "38;2;125;116;102" },
    { "type": "terminal", "key": "term", "keyColor": "38;2;125;116;102" },
    { "type": "memory", "key": "mem",  "keyColor": "38;2;125;116;102" },
    { "type": "uptime", "key": "up",   "keyColor": "38;2;125;116;102" },
    { "type": "custom", "format": "  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500" },
    { "type": "custom", "format": "  vellum \u00b7 Warm paper and sage ink" },
    "break"
  ]
}
