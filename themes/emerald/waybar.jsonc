// emerald — waybar
// Shell: Bottom instrument panel only. Top of screen stays clear.
// This rice's own desktop shell, not a restyle of another profile's.
{
  "name": "panel",
  "layer": "top",
  "position": "bottom",
  "height": 28,
  "modules-left": [
    "custom/ws",
    "hyprland/window"
  ],
  "modules-center": [],
  "modules-right": [
    "cpu",
    "memory",
    "tray",
    "pulseaudio",
    "network",
    "battery",
    "idle_inhibitor",
    "clock"
  ],
  "custom/ws": {
    "exec": "~/.config/waybar/scripts/ws.py all blocks",
    "on-click": "~/.config/waybar/scripts/ws.py cycle 1",
    "on-click-right": "~/.config/waybar/scripts/ws.py cycle -1",
    "on-scroll-up": "~/.config/waybar/scripts/ws.py cycle 1",
    "on-scroll-down": "~/.config/waybar/scripts/ws.py cycle -1",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 50,
    "separate-outputs": true,
    "rewrite": {
      "": "—"
    }
  },
  "cpu": {
    "interval": 5,
    "format": "󰻠 {usage}"
  },
  "memory": {
    "interval": 15,
    "format": "󰍛 {percentage}"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-muted": "󰝟",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "󰋋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "interval": 5,
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format-wifi": "<b>{essid}</b>\n{signalStrength}%  ·  {ipaddr}",
    "on-click": "alacritty --class nm-float -e nmtui"
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "{icon} {capacity}",
    "format-charging": "󰂄 {capacity}",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂂"
    ],
    "tooltip-format": "{capacity}%  ·  {time} left"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊"
    }
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b>{}</b>"
      }
    }
  },
  "spacing": 5
}
