// arctic — waybar
// Shell: waybar-cards
[
  {
    "name": "ws",
    "layer": "top",
    "position": "top",
    "height": 32,
    "width": 180,
    "margin-top": 10,
    "margin-left": 16,
    "spacing": 6,
    "modules-left": [
      "group/workspaces"
    ],
    "modules-center": [],
    "modules-right": [],
    "group/workspaces": {
      "orientation": "horizontal",
      "modules": [
        "custom/ws1",
        "custom/ws2",
        "custom/ws3",
        "custom/ws4",
        "custom/ws5"
      ]
    },
    "custom/ws1": {
      "exec": "~/.config/waybar/scripts/ws.py render dots 1",
      "on-click": "~/.config/waybar/scripts/ws.py focus 1",
      "return-type": "json",
      "restart-interval": 3,
      "cursor": true
    },
    "custom/ws2": {
      "exec": "~/.config/waybar/scripts/ws.py render dots 2",
      "on-click": "~/.config/waybar/scripts/ws.py focus 2",
      "return-type": "json",
      "restart-interval": 3,
      "cursor": true
    },
    "custom/ws3": {
      "exec": "~/.config/waybar/scripts/ws.py render dots 3",
      "on-click": "~/.config/waybar/scripts/ws.py focus 3",
      "return-type": "json",
      "restart-interval": 3,
      "cursor": true
    },
    "custom/ws4": {
      "exec": "~/.config/waybar/scripts/ws.py render dots 4",
      "on-click": "~/.config/waybar/scripts/ws.py focus 4",
      "return-type": "json",
      "restart-interval": 3,
      "cursor": true
    },
    "custom/ws5": {
      "exec": "~/.config/waybar/scripts/ws.py render dots 5",
      "on-click": "~/.config/waybar/scripts/ws.py focus 5",
      "return-type": "json",
      "restart-interval": 3,
      "cursor": true
    }
  },
  {
    "name": "clock",
    "layer": "top",
    "position": "top",
    "height": 32,
    "width": 200,
    "margin-top": 10,
    "spacing": 6,
    "modules-left": [],
    "modules-center": [
      "clock"
    ],
    "modules-right": [],
    "clock": {
      "interval": 10,
      "format": "{:%H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
        "mode": "month",
        "format": {
          "today": "<b>{}</b>"
        }
      }
    }
  },
  {
    "name": "sys",
    "layer": "top",
    "position": "top",
    "height": 32,
    "width": 380,
    "margin-top": 10,
    "margin-right": 16,
    "spacing": 8,
    "modules-left": [],
    "modules-center": [],
    "modules-right": [
      "pulseaudio",
      "network",
      "battery",
      "custom/power"
    ],
    "pulseaudio": {
      "format": "{icon} {volume}",
      "format-muted": "󰝟",
      "scroll-step": 5,
      "format-icons": {
        "headphone": "󰋋",
        "default": [
          "󰕿",
          "󰖀",
          "󰕾"
        ]
      },
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
      "interval": 5,
      "format-wifi": "{icon}",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰤮",
      "format-icons": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "tooltip-format-wifi": "<b>{essid}</b>\n{signalStrength}%  ·  {ipaddr}",
      "on-click": "alacritty --class nm-float -e nmtui"
    },
    "battery": {
      "interval": 30,
      "states": {
        "warning": 25,
        "critical": 12
      },
      "format": "{icon} {capacity}",
      "format-charging": "󰂄 {capacity}",
      "format-icons": [
        "󰁺",
        "󰁼",
        "󰁾",
        "󰂀",
        "󰂂"
      ],
      "tooltip-format": "{capacity}%  ·  {time} left"
    },
    "custom/power": {
      "format": "󰐥",
      "on-click": "~/.config/waybar/scripts/power.sh",
      "tooltip": false,
      "cursor": true
    }
  }
]
