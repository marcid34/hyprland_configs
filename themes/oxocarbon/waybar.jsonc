// oxocarbon — waybar
// Fallback shell. This rice prefers yambar (see shell.components); this is
// what runs if yambar isn't installed, so it degrades to a working Carbon
// data strip rather than to nothing.
{
  "name": "readout",
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,
  "modules-left": [
    "custom/ws",
    "hyprland/window"
  ],
  "modules-center": [],
  "modules-right": [
    "cpu",
    "memory",
    "tray",
    "pulseaudio",
    "backlight",
    "network",
    "battery",
    "custom/notif",
    "idle_inhibitor",
    "clock",
    "custom/power"
  ],
  "custom/ws": {
    "exec": "~/.config/waybar/scripts/ws.py all blocks",
    "on-click": "~/.config/waybar/scripts/ws.py cycle 1",
    "on-click-right": "~/.config/waybar/scripts/ws.py cycle -1",
    "on-scroll-up": "~/.config/waybar/scripts/ws.py cycle 1",
    "on-scroll-down": "~/.config/waybar/scripts/ws.py cycle -1",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 44,
    "separate-outputs": true,
    "rewrite": {
      "": "—"
    }
  },
  "cpu": {
    "interval": 5,
    "format": "CPU {usage}"
  },
  "memory": {
    "interval": 15,
    "format": "MEM {percentage}"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 10
  },
  "pulseaudio": {
    "format": "VOL {volume}",
    "format-muted": "MUTED",
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "backlight": {
    "format": "LUM {percent}",
    "scroll-step": 5
  },
  "network": {
    "interval": 5,
    "format-wifi": "{signalStrength}",
    "format-ethernet": "ETH",
    "format-disconnected": "--",
    "tooltip-format-wifi": "<b>{essid}</b>\n{signalStrength}%  ·  {ipaddr}",
    "on-click": "alacritty --class nm-float -e nmtui"
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "BAT {capacity}",
    "format-charging": "CHG {capacity}",
    "tooltip-format": "{capacity}%  ·  {time} left"
  },
  "custom/notif": {
    "exec": "~/.config/waybar/scripts/notif.py render",
    "on-click": "~/.config/waybar/scripts/notif.py toggle",
    "return-type": "json",
    "interval": 3,
    "cursor": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "AWAKE",
      "deactivated": "IDLE"
    }
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "tooltip": false
  },
  "custom/power": {
    "format": "OFF",
    "on-click": "~/.config/waybar/scripts/power.sh",
    "tooltip": false,
    "cursor": true
  }
}
