/* Windows 11 — Start menu */
configuration {
  modes: "drun"; show-icons: true; icon-theme: "breeze-dark";
  drun-display-format: "{name}";
}
* { background-color: transparent; text-color: #ffffff;
     font: "Adwaita Sans 11"; }
window { width: 640px; background-color: #2b2b2b;
          border: 1px; border-color: #3d3d3d; border-radius: 8px;
          padding: 0; location: center; y-offset: -40px; }
mainbox { children: [ inputbar, listview ]; spacing: 0; padding: 20px; }
inputbar { children: [ prompt, entry ]; padding: 9px 14px; spacing: 10px;
            background-color: #191919; border-radius: 4px;
            border: 1px; border-color: #3d3d3d; }
prompt { text-color: #a0a0a0; }
entry  { placeholder: "Search for apps, settings, and documents";
          placeholder-color: #a0a0a0; }
listview { columns: 6; lines: 3; spacing: 6px; padding: 20px 0 0 0;
            fixed-height: false; scrollbar: false; }
element { orientation: vertical; padding: 14px 4px; border-radius: 4px;
           cursor: pointer; }
element normal.normal, element alternate.normal {
  background-color: transparent; text-color: #e0e0e0; }
element normal.active, element alternate.active {
  background-color: transparent; text-color: #4cc2ff; }
element normal.urgent, element alternate.urgent {
  background-color: transparent; text-color: #f85149; }
element selected.normal, element selected.active {
  background-color: #3d3d3d; text-color: #ffffff; }
element selected.urgent { background-color: #f85149; text-color: #ffffff; }
element-icon { size: 34px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; text-color: inherit; }
