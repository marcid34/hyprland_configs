{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "Windows11",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 9
    },
    "color": {
      "title": "38;2;0;120;212"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "38;2;0;120;212",
        "host": "38;2;76;194;255"
      }
    },
    {
      "type": "custom",
      "format": "────────────────────────────",
      "outputColor": "38;2;61;61;61"
    },
    {
      "type": "os",
      "key": "os",
      "keyColor": "38;2;0;120;212"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "keyColor": "38;2;0;120;212"
    },
    {
      "type": "uptime",
      "key": "uptime",
      "keyColor": "38;2;0;120;212"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "keyColor": "38;2;0;120;212"
    },
    {
      "type": "shell",
      "key": "shell",
      "keyColor": "38;2;0;120;212"
    },
    {
      "type": "wm",
      "key": "wm",
      "keyColor": "38;2;76;194;255"
    },
    {
      "type": "terminal",
      "key": "term",
      "keyColor": "38;2;76;194;255"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "keyColor": "38;2;76;194;255"
    },
    {
      "type": "memory",
      "key": "mem",
      "keyColor": "38;2;108;203;95"
    },
    {
      "type": "disk",
      "key": "disk",
      "keyColor": "38;2;108;203;95"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
