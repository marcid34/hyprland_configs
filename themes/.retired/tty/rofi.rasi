/* tty — rofi
 *
 * A console picker. Square, opaque, 1px green frame, and the selection is
 * an inverted row — exactly how a curses list highlights. Icons are
 * collapsed to zero rather than disabled, because show-icons lives in the
 * shared behaviour block that themes must not touch.
 */

* {
  crust:    #11111b;
  base:     #1e1e2e;
  surface0: #313244;
  surface1: #45475a;
  overlay0: #6c7086;
  green:    #a6e3a1;
  teal:     #94e2d5;
  yellow:   #f9e2af;
  red:      #f38ba8;

  background-color: transparent;
  text-color:       @green;
  font:             "JetBrainsMono Nerd Font Mono 11";
}

window {
  width:            600px;
  background-color: @crust;
  border:           1px;
  border-color:     @green;
  border-radius:    0;
  padding:          0;
}

mainbox {
  children: [ inputbar, listview ];
  spacing:  0;
}

inputbar {
  children:     [ prompt, entry ];
  padding:      8px 10px;
  spacing:      8px;
  border:       0 0 1px 0;
  border-color: @surface1;
}

prompt {
  background-color: transparent;
  text-color:       @teal;
  padding:          0;
}

entry {
  placeholder:    "";
  cursor:         text;
  text-color:     @green;
  vertical-align: 0.5;
}

listview {
  lines:        12;
  columns:      1;
  padding:      2px 0;
  spacing:      0;
  scrollbar:    false;
  fixed-height: false;
}

/* Full-bleed rows: no side padding on the listview, no rounding, no gap —
 * the selected row spans the whole width like a terminal highlight. */
element {
  padding:       2px 10px;
  spacing:       8px;
  border-radius: 0;
  cursor:        pointer;
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color:       @green;
}

element normal.active,
element alternate.active {
  background-color: transparent;
  text-color:       @teal;
}

element normal.urgent,
element alternate.urgent {
  background-color: transparent;
  text-color:       @red;
}

element selected.normal,
element selected.active {
  background-color: @green;
  text-color:       @crust;
}

element selected.urgent {
  background-color: @red;
  text-color:       @crust;
}

element-icon {
  size:    0px;
  enabled: false;
}

element-text {
  vertical-align: 0.5;
  text-color:     inherit;
}
