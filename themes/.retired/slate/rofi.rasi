/* slate — rofi
 *
 * Dense and flat, on mantle. The selection is a surface0 fill with a blue
 * left edge rather than a saturated bar — same restraint as the bar, where
 * the accent is an underline instead of a highlight.
 */

* {
  crust:    #11111b;
  mantle:   #181825;
  base:     #1e1e2e;
  surface0: #313244;
  surface1: #45475a;
  overlay0: #6c7086;
  subtext0: #a6adc8;
  text:     #cdd6f4;
  blue:     #89b4fa;
  red:      #f38ba8;

  background-color: transparent;
  text-color:       @subtext0;
  font:             "Ubuntu Mono 12";
}

window {
  width:            480px;
  background-color: @mantle;
  border:           1px;
  border-color:     @surface0;
  border-radius:    6px;
  padding:          0;
}

mainbox {
  children: [ inputbar, listview ];
  spacing:  0;
}

inputbar {
  children:     [ prompt, entry ];
  padding:      9px 12px;
  spacing:      9px;
  border:       0 0 1px 0;
  border-color: @surface0;
}

prompt {
  background-color: transparent;
  text-color:       @blue;
  padding:          0;
}

entry {
  placeholder:    "";
  cursor:         text;
  text-color:     @text;
  vertical-align: 0.5;
}

listview {
  lines:        9;
  columns:      1;
  padding:      4px;
  spacing:      1px;
  scrollbar:    false;
  fixed-height: false;
}

element {
  padding:       5px 9px;
  spacing:       10px;
  border-radius: 3px;
  border:        0 0 0 2px;
  border-color:  transparent;
  cursor:        pointer;
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color:       @subtext0;
}

element normal.active,
element alternate.active {
  background-color: transparent;
  text-color:       @blue;
}

element normal.urgent,
element alternate.urgent {
  background-color: transparent;
  text-color:       @red;
}

element selected.normal,
element selected.active {
  background-color: @surface0;
  text-color:       @text;
  border-color:     @blue;
}

element selected.urgent {
  background-color: @surface0;
  text-color:       @red;
  border-color:     @red;
}

element-icon {
  size:           17px;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color:     inherit;
}
