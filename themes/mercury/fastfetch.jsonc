{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    },
    "color": {
      "1": "38;2;111;168;220",
      "2": "38;2;169;199;232"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 9
    },
    "color": {
      "title": "38;2;111;168;220"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "38;2;111;168;220",
        "host": "38;2;169;199;232"
      }
    },
    {
      "type": "custom",
      "format": "────────────────────────────",
      "outputColor": "38;2;43;49;58"
    },
    {
      "type": "os",
      "key": "os",
      "keyColor": "38;2;111;168;220"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "keyColor": "38;2;111;168;220"
    },
    {
      "type": "uptime",
      "key": "uptime",
      "keyColor": "38;2;111;168;220"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "keyColor": "38;2;111;168;220"
    },
    {
      "type": "shell",
      "key": "shell",
      "keyColor": "38;2;111;168;220"
    },
    {
      "type": "wm",
      "key": "wm",
      "keyColor": "38;2;169;199;232"
    },
    {
      "type": "terminal",
      "key": "term",
      "keyColor": "38;2;169;199;232"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "keyColor": "38;2;169;199;232"
    },
    {
      "type": "gpu",
      "key": "gpu",
      "keyColor": "38;2;169;199;232"
    },
    {
      "type": "memory",
      "key": "mem",
      "keyColor": "38;2;143;184;168"
    },
    {
      "type": "disk",
      "key": "disk",
      "keyColor": "38;2;143;184;168"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
