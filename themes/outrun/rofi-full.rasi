/* Full-screen overlay launcher — takes the whole display. */
configuration {
  modes:      "drun";
  show-icons: true;
  icon-theme: "breeze-dark";
  drun-display-format: "{name}";
}
* { background-color: transparent; text-color: #f0e6ff;
     font: "JetBrainsMono Nerd Font 13"; }
window { fullscreen: true; background-color: #0d0221f7; padding: 8%; }
mainbox { children: [ inputbar, listview ]; spacing: 26px; }
inputbar { children: [ prompt, entry ]; spacing: 16px;
            padding: 0 0 18px 0; border: 0 0 2px 0; border-color: #ff2e97; }
prompt { text-color: #ff2e97; font: "JetBrainsMono Nerd Font 20"; }
entry  { placeholder: "type to search"; placeholder-color: #3b2d6b;
          font: "JetBrainsMono Nerd Font 20"; }
listview { columns: 2; lines: 8; spacing: 6px; scrollbar: false;
            fixed-height: false; }
element { padding: 12px 16px; spacing: 14px; border-radius: 8px;
           cursor: pointer; }
element normal.normal, element alternate.normal {
  background-color: transparent; text-color: #f0e6ff; }
element normal.active, element alternate.active {
  background-color: transparent; text-color: #ff2e97; }
element normal.urgent, element alternate.urgent {
  background-color: transparent; text-color: #ff2e97; }
element selected.normal, element selected.active {
  background-color: #ff2e97; text-color: #0d0221; }
element selected.urgent { background-color: #ff2e97; text-color: #0d0221; }
element-icon { size: 26px; }
element-text { vertical-align: 0.5; text-color: inherit; }
