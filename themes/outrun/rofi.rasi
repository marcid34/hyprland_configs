/* outrun — rofi
 *
 * A neon sign. Magenta frame, cyan prompt, and a selected row that fills
 * magenta with dark text — the highest-contrast thing on the screen, which
 * is exactly right for the one row you are about to launch.
 */

configuration {
  modes:               "drun,run";
  show-icons:          true;
  icon-theme:          "breeze-dark";
  drun-display-format: "{name}";
  display-drun:        "apps";
  display-run:         "run";
  drun-match-fields:   "name,generic,exec,keywords";
}

* {
  bg:      #0d0221;
  bg1:     #190b33;
  bg2:     #241b4d;
  bg3:     #3b2d6b;
  fg:      #f0e6ff;
  fg1:     #c9b8f0;
  dim:     #6b5b9a;
  magenta: #ff2e97;
  cyan:    #00f0ff;
  purple:  #b967ff;
  yellow:  #fffb96;

  background-color: transparent;
  text-color:       @fg1;
  font:             "JetBrainsMono Nerd Font Propo 12";
}

window {
  width:            580px;
  background-color: #0d0221ee;
  border:           2px;
  border-color:     @magenta;
  border-radius:    6px;
  padding:          0;
}

mainbox {
  children: [ inputbar, listview ];
  spacing:  0;
}

inputbar {
  children:         [ prompt, entry ];
  padding:          14px 16px;
  spacing:          12px;
  background-color: #190b3399;
  border:           0 0 2px 0;
  border-color:     @bg3;
}

prompt {
  background-color: @cyan;
  text-color:       @bg;
  padding:          2px 12px;
  border-radius:    3px;
}

entry {
  placeholder:       "run";
  placeholder-color: @dim;
  cursor:            text;
  text-color:        @fg;
  vertical-align:    0.5;
}

listview {
  lines:        9;
  columns:      1;
  padding:      6px;
  spacing:      2px;
  scrollbar:    false;
  fixed-height: false;
}

element {
  padding:       9px 13px;
  spacing:       12px;
  border-radius: 3px;
  border:        0 0 0 2px;
  border-color:  transparent;
  cursor:        pointer;
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color:       @fg1;
}

element normal.active,
element alternate.active {
  background-color: transparent;
  text-color:       @cyan;
}

element normal.urgent,
element alternate.urgent {
  background-color: transparent;
  text-color:       @yellow;
}

element selected.normal,
element selected.active {
  background-color: @magenta;
  text-color:       @bg;
  border-color:     @cyan;
}

element selected.urgent {
  background-color: @yellow;
  text-color:       @bg;
  border-color:     @magenta;
}

element-icon {
  size:           20px;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color:     inherit;
}
