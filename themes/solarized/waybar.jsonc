// solarized — waybar
// Fallback shell. This rice prefers nwg-panel (see shell.components); if
// that isn't installed, shell.sh falls back to this so the rice is still
// usable rather than coming up with no chrome at all.
{
  "name": "panel",
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 8,
  "modules-left": [
    "custom/launcher",
    "group/workspaces",
    "hyprland/window"
  ],
  "modules-center": [],
  "modules-right": [
    "custom/media",
    "tray",
    "cpu",
    "memory",
    "pulseaudio",
    "network",
    "battery",
    "custom/notif",
    "clock",
    "custom/power"
  ],
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "custom/ws1",
      "custom/ws2",
      "custom/ws3",
      "custom/ws4",
      "custom/ws5"
    ]
  },
  "custom/launcher": {
    "format": "",
    "on-click": "~/.config/themes/launch.sh",
    "tooltip": false,
    "cursor": true
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 46,
    "separate-outputs": true,
    "rewrite": {
      "": "—"
    }
  },
  "custom/media": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/player.sh",
    "on-click": "playerctl play-pause",
    "max-length": 28,
    "interval": 5
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "cpu": {
    "interval": 5,
    "format": "cpu {usage}"
  },
  "memory": {
    "interval": 15,
    "format": "mem {percentage}"
  },
  "pulseaudio": {
    "format": "vol {volume}",
    "format-muted": "muted",
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "interval": 5,
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format-wifi": "<b>{essid}</b>\n{signalStrength}%  ·  {ipaddr}",
    "on-click": "alacritty --class nm-float -e nmtui"
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "bat {capacity}",
    "format-charging": "chg {capacity}",
    "tooltip-format": "{capacity}%  ·  {time} left"
  },
  "custom/notif": {
    "exec": "~/.config/waybar/scripts/notif.py render",
    "on-click": "~/.config/waybar/scripts/notif.py toggle",
    "return-type": "json",
    "interval": 3,
    "cursor": true
  },
  "clock": {
    "interval": 10,
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b>{}</b>"
      }
    }
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "~/.config/waybar/scripts/power.sh",
    "tooltip": false,
    "cursor": true
  },
  "custom/ws1": {
    "exec": "~/.config/waybar/scripts/ws.py render numbers 1",
    "on-click": "~/.config/waybar/scripts/ws.py focus 1",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  },
  "custom/ws2": {
    "exec": "~/.config/waybar/scripts/ws.py render numbers 2",
    "on-click": "~/.config/waybar/scripts/ws.py focus 2",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  },
  "custom/ws3": {
    "exec": "~/.config/waybar/scripts/ws.py render numbers 3",
    "on-click": "~/.config/waybar/scripts/ws.py focus 3",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  },
  "custom/ws4": {
    "exec": "~/.config/waybar/scripts/ws.py render numbers 4",
    "on-click": "~/.config/waybar/scripts/ws.py focus 4",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  },
  "custom/ws5": {
    "exec": "~/.config/waybar/scripts/ws.py render numbers 5",
    "on-click": "~/.config/waybar/scripts/ws.py focus 5",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  }
}
