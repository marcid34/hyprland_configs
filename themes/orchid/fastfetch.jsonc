{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "left": 2, "right": 4 },
    "color": { "1": "38;2;194;148;255", "2": "38;2;255;159;216" }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 9 },
    "color": { "title": "38;2;194;148;255" }
  },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "38;2;194;148;255", "host": "38;2;255;159;216" } },
    { "type": "custom", "format": "  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500" },
    { "type": "os",     "key": "os",   "keyColor": "38;2;162;146;180" },
    { "type": "kernel", "key": "kern", "keyColor": "38;2;162;146;180" },
    { "type": "wm",     "key": "wm",   "keyColor": "38;2;162;146;180" },
    { "type": "shell",  "key": "sh",   "keyColor": "38;2;162;146;180" },
    { "type": "terminal", "key": "term", "keyColor": "38;2;162;146;180" },
    { "type": "memory", "key": "mem",  "keyColor": "38;2;162;146;180" },
    { "type": "uptime", "key": "up",   "keyColor": "38;2;162;146;180" },
    { "type": "custom", "format": "  \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500" },
    { "type": "custom", "format": "  orchid \u00b7 Plum dusk and lilac light" },
    "break"
  ]
}
