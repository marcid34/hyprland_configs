{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "left": 2, "right": 4 },
    "color": { "1": "38;2;200;68;58", "2": "38;2;232;177;61" }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 9 },
    "color": { "title": "38;2;200;68;58" }
  },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "38;2;200;68;58", "host": "38;2;232;177;61" } },
    { "type": "custom", "format": "────────────────────────────",
      "outputColor": "38;2;95;44;34" },
    { "type": "os",       "key": "world",  "keyColor": "38;2;200;68;58" },
    { "type": "kernel",   "key": "seed",   "keyColor": "38;2;200;68;58" },
    { "type": "uptime",   "key": "played", "keyColor": "38;2;200;68;58" },
    { "type": "packages", "key": "items",  "keyColor": "38;2;200;68;58" },
    { "type": "shell",    "key": "shell",  "keyColor": "38;2;200;68;58" },
    { "type": "wm",       "key": "wm",     "keyColor": "38;2;232;177;61" },
    { "type": "terminal", "key": "term",   "keyColor": "38;2;232;177;61" },
    { "type": "cpu",      "key": "cpu",    "keyColor": "38;2;134;160;155" },
    { "type": "gpu",      "key": "gpu",    "keyColor": "38;2;134;160;155" },
    { "type": "memory",   "key": "mana",   "keyColor": "38;2;138;155;122" },
    { "type": "disk",     "key": "chest",  "keyColor": "38;2;138;155;122" },
    "break",
    { "type": "colors", "symbol": "circle" },
    "break"
  ]
}
