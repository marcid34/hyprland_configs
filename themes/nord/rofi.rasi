/* nord — rofi
 *
 * Nord — arctic. Cool blue-greys, frost cyan, zero warmth.
 * All nine element states are declared: rofi fills any state you leave
 * unnamed from its built-in Solarized default theme.
 */

configuration {
  modes:               "drun,run";
  show-icons:          true;
  icon-theme:          "breeze-dark";
  drun-display-format: "{name}";
  display-drun:        "apps";
  display-run:         "run";
  drun-match-fields:   "name,generic,exec,keywords";
}

* {
  bg:  #2e3440;   bg1: #272c36;  bg2: #3b4252;  bg3: #4c566a;
  fg:  #eceff4;   fg1: #d8dee9;  dim: #6b7789;
  ac:  #88c0d0;  ac2: #81a1c1;  red: #bf616a;

  background-color: transparent;
  text-color:       @fg1;
  font:             "Adwaita Sans 12";
}

window {
  width:            520px;
  background-color: #272c36;
  border:           1px;
  border-color:     @bg3;
  border-radius:    0px;
  padding:          0;
}

mainbox { children: [ inputbar, listview ]; spacing: 0; }

inputbar {
  children:     [ prompt, entry ];
  padding:      10px 12px;
  spacing:      10px;
  border:       0 0 1px 0;
  border-color: @bg3;
}

prompt { background-color: transparent; text-color: @ac; padding: 0; }

entry {
  placeholder: "";
  cursor: text; text-color: @fg; vertical-align: 0.5;
}

listview {
  lines: 9;
  columns: 1;
  padding: 0px;
  spacing: 0px;
  scrollbar: false; fixed-height: false;
}

element {
  padding:       5px 14px;
  spacing:       11px;
  border-radius: 0px;
  cursor:        pointer;
}

element normal.normal, element alternate.normal {
  background-color: transparent; text-color: @fg1;
}
element normal.active, element alternate.active {
  background-color: transparent; text-color: @ac2;
}
element normal.urgent, element alternate.urgent {
  background-color: transparent; text-color: @red;
}
element selected.normal, element selected.active {
  background-color: #88c0d0; text-color: #2e3440;
}
element selected.urgent {
  background-color: @red; text-color: @bg;
}

element-icon { size: 19px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
