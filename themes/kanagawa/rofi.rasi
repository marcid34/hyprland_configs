/* kanagawa — rofi
 *
 * A printed page. Warm sumi ground, a wave-blue rule under the prompt, and
 * a carp-yellow selection block — the one saturated mark on the page.
 */

configuration {
  modes:               "drun,run";
  show-icons:          true;
  icon-theme:          "breeze-dark";
  drun-display-format: "{name}";
  display-drun:        "apps";
  display-run:         "run";
  drun-match-fields:   "name,generic,exec,keywords";
}

* {
  sumi0:   #16161d;
  sumi3:   #1f1f28;
  sumi4:   #2a2a37;
  wave2:   #2d4f67;
  fuji:    #dcd7ba;
  old:     #c8c093;
  gray:    #727169;
  carp:    #e6c384;
  crystal: #7e9cd8;
  aqua:    #7aa89f;
  autumn:  #c34043;

  background-color: transparent;
  text-color:       @old;
  font:             "Ubuntu 12";
}

window {
  width:            560px;
  background-color: #16161dfa;
  border:           1px;
  border-color:     @sumi4;
  border-radius:    8px;
  padding:          0;
}

mainbox {
  children: [ inputbar, listview ];
  spacing:  0;
}

inputbar {
  children:     [ prompt, entry ];
  padding:      13px 18px;
  spacing:      12px;
  border:       0 0 1px 0;
  border-color: @wave2;
}

prompt {
  background-color: @carp;
  text-color:       @sumi3;
  padding:          2px 11px;
  border-radius:    4px;
}

entry {
  placeholder:    "";
  cursor:         text;
  text-color:     @fuji;
  vertical-align: 0.5;
}

listview {
  lines:        9;
  columns:      1;
  padding:      7px;
  spacing:      2px;
  scrollbar:    false;
  fixed-height: false;
}

element {
  padding:       8px 12px;
  spacing:       12px;
  border-radius: 4px;
  cursor:        pointer;
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color:       @old;
}

element normal.active,
element alternate.active {
  background-color: transparent;
  text-color:       @crystal;
}

element normal.urgent,
element alternate.urgent {
  background-color: transparent;
  text-color:       @autumn;
}

element selected.normal,
element selected.active {
  background-color: @carp;
  text-color:       @sumi3;
}

element selected.urgent {
  background-color: @autumn;
  text-color:       @fuji;
}

element-icon {
  size:           20px;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color:     inherit;
}
