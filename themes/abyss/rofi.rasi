/* abyss — rofi
 *
 * Abyss — deep water. Near-black navy, teal and electric cyan.
 * All nine element states are declared: rofi fills any state you leave
 * unnamed from its built-in Solarized default theme.
 */

configuration {
  modes:               "drun,run";
  show-icons:          true;
  icon-theme:          "breeze-dark";
  drun-display-format: "{name}";
  display-drun:        "apps";
  display-run:         "run";
  drun-match-fields:   "name,generic,exec,keywords";
}

* {
  bg:  #0b1220;   bg1: #0f1a2b;  bg2: #152438;  bg3: #1d3050;
  fg:  #cfe3f5;   fg1: #9fbcd6;  dim: #4a6483;
  ac:  #2ec4b6;  ac2: #48cae4;  red: #ef476f;

  background-color: transparent;
  text-color:       @fg1;
  font:             "JetBrainsMono Nerd Font Propo 12";
}

window {
  width:            520px;
  background-color: #0f1a2b;
  border:           1px;
  border-color:     @bg3;
  border-radius:    14px;
  padding:          0;
}

mainbox { children: [ inputbar, listview ]; spacing: 0; }

inputbar {
  children:     [ prompt, entry ];
  padding:      14px 16px;
  spacing:      10px;
  border:       0 0 1px 0;
  border-color: @bg3;
}

prompt { background-color: transparent; text-color: @ac; padding: 0; }

entry {
  placeholder: "";
  cursor: text; text-color: @fg; vertical-align: 0.5;
}

listview {
  lines: 9;
  columns: 1;
  padding: 6px;
  spacing: 2px;
  scrollbar: false; fixed-height: false;
}

element {
  padding:       8px 12px;
  spacing:       11px;
  border-radius: 8px;
  cursor:        pointer;
}

element normal.normal, element alternate.normal {
  background-color: transparent; text-color: @fg1;
}
element normal.active, element alternate.active {
  background-color: transparent; text-color: @ac2;
}
element normal.urgent, element alternate.urgent {
  background-color: transparent; text-color: @red;
}
element selected.normal, element selected.active {
  background-color: #2ec4b62e; text-color: #2ec4b6;
}
element selected.urgent {
  background-color: @red; text-color: @bg;
}

element-icon { size: 19px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
