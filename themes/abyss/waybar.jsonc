// abyss — waybar
// Shell: Three genuinely separate floating islands, gaps showing wallpaper.
// This rice's own desktop shell, not a restyle of another profile's.
[
  {
    "name": "i1",
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 10,
    "margin-left": 14,
    "modules-left": [
      "group/workspaces"
    ],
    "modules-center": [],
    "modules-right": [],
    "group/workspaces": {
      "orientation": "horizontal",
      "modules": [
        "custom/ws1",
        "custom/ws2",
        "custom/ws3",
        "custom/ws4",
        "custom/ws5"
      ]
    },
    "custom/ws1": {
      "exec": "~/.config/waybar/scripts/ws.py render dots 1",
      "on-click": "~/.config/waybar/scripts/ws.py focus 1",
      "return-type": "json",
      "restart-interval": 3,
      "cursor": true
    },
    "custom/ws2": {
      "exec": "~/.config/waybar/scripts/ws.py render dots 2",
      "on-click": "~/.config/waybar/scripts/ws.py focus 2",
      "return-type": "json",
      "restart-interval": 3,
      "cursor": true
    },
    "custom/ws3": {
      "exec": "~/.config/waybar/scripts/ws.py render dots 3",
      "on-click": "~/.config/waybar/scripts/ws.py focus 3",
      "return-type": "json",
      "restart-interval": 3,
      "cursor": true
    },
    "custom/ws4": {
      "exec": "~/.config/waybar/scripts/ws.py render dots 4",
      "on-click": "~/.config/waybar/scripts/ws.py focus 4",
      "return-type": "json",
      "restart-interval": 3,
      "cursor": true
    },
    "custom/ws5": {
      "exec": "~/.config/waybar/scripts/ws.py render dots 5",
      "on-click": "~/.config/waybar/scripts/ws.py focus 5",
      "return-type": "json",
      "restart-interval": 3,
      "cursor": true
    },
    "width": 150,
    "spacing": 5
  },
  {
    "name": "i2",
    "layer": "top",
    "position": "top",
    "height": 34,
    "width": 260,
    "margin-top": 10,
    "modules-left": [],
    "modules-center": [
      "clock"
    ],
    "modules-right": [],
    "clock": {
      "interval": 10,
      "format": "{:%H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
        "mode": "month",
        "format": {
          "today": "<b>{}</b>"
        }
      }
    },
    "spacing": 5
  },
  {
    "name": "i3",
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 10,
    "margin-right": 14,
    "modules-left": [],
    "modules-center": [],
    "modules-right": [
      "pulseaudio",
      "backlight",
      "network",
      "battery"
    ],
    "pulseaudio": {
      "format": "{icon} {volume}",
      "format-muted": "󰝟",
      "scroll-step": 5,
      "format-icons": {
        "headphone": "󰋋",
        "default": [
          "󰕿",
          "󰖀",
          "󰕾"
        ]
      },
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "backlight": {
      "format": "{icon} {percent}",
      "format-icons": [
        "󰃞",
        "󰃟",
        "󰃠"
      ],
      "scroll-step": 5
    },
    "network": {
      "interval": 5,
      "format-wifi": "{icon}",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰤮",
      "format-icons": [
        "󰤯",
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "tooltip-format-wifi": "<b>{essid}</b>\n{signalStrength}%  ·  {ipaddr}",
      "on-click": "alacritty --class nm-float -e nmtui"
    },
    "battery": {
      "interval": 30,
      "states": {
        "warning": 25,
        "critical": 12
      },
      "format": "{icon} {capacity}",
      "format-charging": "󰂄 {capacity}",
      "format-icons": [
        "󰁺",
        "󰁼",
        "󰁾",
        "󰂀",
        "󰂂"
      ],
      "tooltip-format": "{capacity}%  ·  {time} left"
    },
    "width": 330,
    "spacing": 5
  }
]
