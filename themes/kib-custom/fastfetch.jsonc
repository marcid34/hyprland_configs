{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // kib-custom — Catppuccin Mocha. Mauve keys on the small Arch logo,
  // matching the bar's accent.
  "logo": {
    "type": "small",
    "padding": { "top": 1, "left": 2, "right": 4 },
    "color": { "1": "38;2;203;166;247" }
  },

  "display": {
    "separator": "  ",
    "key": { "width": 9 },
    "color": { "title": "38;2;203;166;247" }
  },

  "modules": [
    "break",
    { "type": "title", "color": { "user": "38;2;203;166;247", "host": "38;2;137;180;250" } },
    { "type": "custom", "format": "────────────────────────────", "outputColor": "38;2;69;71;90" },
    { "type": "os",      "key": "os",     "keyColor": "38;2;203;166;247" },
    { "type": "kernel",  "key": "kernel", "keyColor": "38;2;203;166;247" },
    { "type": "uptime",  "key": "uptime", "keyColor": "38;2;203;166;247" },
    { "type": "packages","key": "pkgs",   "keyColor": "38;2;203;166;247" },
    { "type": "shell",   "key": "shell",  "keyColor": "38;2;203;166;247" },
    { "type": "wm",      "key": "wm",     "keyColor": "38;2;137;180;250" },
    { "type": "terminal","key": "term",   "keyColor": "38;2;137;180;250" },
    { "type": "cpu",     "key": "cpu",    "keyColor": "38;2;148;226;213" },
    { "type": "gpu",     "key": "gpu",    "keyColor": "38;2;148;226;213" },
    { "type": "memory",  "key": "mem",    "keyColor": "38;2;166;227;161" },
    { "type": "disk",    "key": "disk",   "keyColor": "38;2;166;227;161" },
    "break",
    { "type": "colors", "symbol": "circle" },
    "break"
  ]
}
