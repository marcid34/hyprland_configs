// plum — waybar
// Shell: One oversized centred card. A widget, not a bar.
// This rice's own desktop shell, not a restyle of another profile's.
{
  "name": "card",
  "layer": "top",
  "position": "top",
  "height": 54,
  "width": 620,
  "margin-top": 12,
  "modules-left": [
    "custom/ws"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "battery",
    "custom/power"
  ],
  "custom/ws": {
    "exec": "~/.config/waybar/scripts/ws.py all dots",
    "on-click": "~/.config/waybar/scripts/ws.py cycle 1",
    "on-click-right": "~/.config/waybar/scripts/ws.py cycle -1",
    "on-scroll-up": "~/.config/waybar/scripts/ws.py cycle 1",
    "on-scroll-down": "~/.config/waybar/scripts/ws.py cycle -1",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  },
  "clock": {
    "interval": 10,
    "format": "{:%A  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b>{}</b>"
      }
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-muted": "󰝟",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "󰋋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "{icon} {capacity}",
    "format-charging": "󰂄 {capacity}",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂂"
    ],
    "tooltip-format": "{capacity}%  ·  {time} left"
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "~/.config/waybar/scripts/power.sh",
    "tooltip": false,
    "cursor": true
  },
  "spacing": 5
}
