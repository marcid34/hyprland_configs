/* rosepine — rofi
 *
 * Borderless and airy, matching the bar. The selected row is a rose-tinted
 * surface with no outline; separation comes from fill and spacing only.
 */

configuration {
  modes:               "drun,run";
  show-icons:          true;
  icon-theme:          "breeze-dark";
  drun-display-format: "{name}";
  display-drun:        "apps";
  display-run:         "run";
  drun-match-fields:   "name,generic,exec,keywords";
}

* {
  base:      #191724;
  surface:   #1f1d2e;
  overlay:   #26233a;
  hl-med:    #403d52;
  text:      #e0def4;
  subtle:    #908caa;
  muted:     #6e6a86;
  love:      #eb6f92;
  gold:      #f6c177;
  rose:      #ebbcba;
  foam:      #9ccfd8;
  iris:      #c4a7e7;

  background-color: transparent;
  text-color:       @text;
  font:             "Adwaita Sans 12";
}

window {
  width:            540px;
  background-color: #1f1d2ef2;
  border:           0;
  border-radius:    18px;
  padding:          0;
}

mainbox {
  children: [ inputbar, listview ];
  spacing:  0;
}

inputbar {
  children: [ prompt, entry ];
  padding:  18px 22px 12px 22px;
  spacing:  12px;
  border:   0;
}

prompt {
  background-color: transparent;
  text-color:       @rose;
  padding:          0;
}

entry {
  placeholder:       "search";
  placeholder-color: @muted;
  cursor:            text;
  text-color:        @text;
  vertical-align:    0.5;
}

listview {
  lines:        9;
  columns:      1;
  padding:      6px 10px 12px 10px;
  spacing:      2px;
  scrollbar:    false;
  fixed-height: false;
}

element {
  padding:       10px 14px;
  spacing:       14px;
  border-radius: 12px;
  cursor:        pointer;
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color:       @subtle;
}

element normal.active,
element alternate.active {
  background-color: transparent;
  text-color:       @foam;
}

element normal.urgent,
element alternate.urgent {
  background-color: transparent;
  text-color:       @love;
}

element selected.normal,
element selected.active {
  background-color: #ebbcba1f;
  text-color:       @rose;
}

element selected.urgent {
  background-color: #eb6f921f;
  text-color:       @love;
}

element-icon {
  size:           22px;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color:     inherit;
}
