// Mac OS X — waybar
// macOS — translucent menubar up top, magnified dock below.
{
  "name": "menubar",
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 16,
  "modules-left": [
    "custom/apple",
    "hyprland/window"
  ],
  "modules-center": [],
  "modules-right": [
    "custom/media",
    "cpu",
    "network",
    "pulseaudio",
    "battery",
    "custom/notif",
    "clock"
  ],
  "custom/apple": {
    "format": "",
    "on-click": "~/.config/themes/launch.sh",
    "tooltip": false,
    "cursor": true
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 40,
    "separate-outputs": true,
    "rewrite": {
      "": "Finder"
    }
  },
  "custom/media": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/player.sh",
    "on-click": "playerctl play-pause",
    "max-length": 22,
    "interval": 5
  },
  "cpu": {
    "interval": 5,
    "format": "{usage}%"
  },
  "network": {
    "interval": 5,
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format-wifi": "<b>{essid}</b>\n{signalStrength}%  ·  {ipaddr}",
    "on-click": "alacritty --class nm-float -e nmtui"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "scroll-step": 5,
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂂"
    ]
  },
  "custom/notif": {
    "exec": "~/.config/waybar/scripts/notif.py render",
    "on-click": "~/.config/waybar/scripts/notif.py toggle",
    "return-type": "json",
    "interval": 3,
    "cursor": true
  },
  "clock": {
    "interval": 10,
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b>{}</b>"
      }
    }
  }
}
