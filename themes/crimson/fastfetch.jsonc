{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    },
    "color": {
      "1": "38;2;199;44;72",
      "2": "38;2;224;96;122"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 9
    },
    "color": {
      "title": "38;2;199;44;72"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "38;2;199;44;72",
        "host": "38;2;224;96;122"
      }
    },
    {
      "type": "custom",
      "format": "────────────────────────────",
      "outputColor": "38;2;62;31;40"
    },
    {
      "type": "os",
      "key": "os",
      "keyColor": "38;2;199;44;72"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "keyColor": "38;2;199;44;72"
    },
    {
      "type": "uptime",
      "key": "uptime",
      "keyColor": "38;2;199;44;72"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "keyColor": "38;2;199;44;72"
    },
    {
      "type": "shell",
      "key": "shell",
      "keyColor": "38;2;199;44;72"
    },
    {
      "type": "wm",
      "key": "wm",
      "keyColor": "38;2;224;96;122"
    },
    {
      "type": "terminal",
      "key": "term",
      "keyColor": "38;2;224;96;122"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "keyColor": "38;2;124;168;160"
    },
    {
      "type": "memory",
      "key": "mem",
      "keyColor": "38;2;143;168;124"
    },
    {
      "type": "disk",
      "key": "disk",
      "keyColor": "38;2;143;168;124"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
