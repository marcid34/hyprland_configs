/* tokyonight — rofi
 *
 * Glassy navy panel, generous rows, and a selection that is a soft blue wash
 * with a luminous left edge rather than a solid bar.
 */

configuration {
  modes:               "drun,run";
  show-icons:          true;
  icon-theme:          "breeze-dark";
  drun-display-format: "{name}";
  display-drun:        "apps";
  display-run:         "run";
  drun-match-fields:   "name,generic,exec,keywords";
}

* {
  bg:      #1a1b26;
  bg1:     #16161e;
  bg2:     #292e42;
  bg3:     #3b4261;
  fg:      #c0caf5;
  fg1:     #a9b1d6;
  dim:     #565f89;
  blue:    #7aa2f7;
  purple:  #bb9af7;
  cyan:    #7dcfff;
  red:     #f7768e;

  background-color: transparent;
  text-color:       @fg;
  font:             "JetBrainsMono Nerd Font Propo 12";
}

window {
  width:            560px;
  background-color: #1a1b26e0;
  border:           1px;
  border-color:     @bg3;
  border-radius:    16px;
  padding:          0;
}

mainbox {
  children: [ inputbar, listview ];
  spacing:  0;
}

inputbar {
  children:     [ prompt, entry ];
  padding:      14px 18px;
  spacing:      12px;
  border:       0 0 1px 0;
  border-color: @bg2;
}

prompt {
  background-color: #7aa2f733;
  text-color:       @blue;
  padding:          3px 12px;
  border-radius:    10px;
}

entry {
  placeholder:    "";
  cursor:         text;
  text-color:     @fg;
  vertical-align: 0.5;
}

listview {
  lines:        9;
  columns:      1;
  padding:      8px;
  spacing:      3px;
  scrollbar:    false;
  fixed-height: false;
}

element {
  padding:       9px 14px;
  spacing:       12px;
  border-radius: 10px;
  border:        0 0 0 2px;
  border-color:  transparent;
  cursor:        pointer;
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color:       @fg1;
}

element normal.active,
element alternate.active {
  background-color: transparent;
  text-color:       @cyan;
}

element normal.urgent,
element alternate.urgent {
  background-color: transparent;
  text-color:       @red;
}

element selected.normal,
element selected.active {
  background-color: #7aa2f72e;
  text-color:       @fg;
  border-color:     @blue;
}

element selected.urgent {
  background-color: #f7768e2e;
  text-color:       @red;
  border-color:     @red;
}

element-icon {
  size:           21px;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color:     inherit;
}
