/* moss — rofi (default list; this rice's launcher is rofi) */
configuration {
  modes: "drun,run"; show-icons: true; icon-theme: "breeze-dark";
  drun-display-format: "{name}"; display-drun: "apps"; display-run: "run";
  drun-match-fields: "name,generic,exec,keywords";
}
* { bg:#1c201b; bg1:#232821; bg2:#2c322a; bg3:#3a4136;
     fg:#d4d8cc; fg1:#a4ab9c; dim:#6c7466; ac:#8fa876;
     ac2:#7c9a8e; red:#a87c7c;
     background-color: transparent; text-color: @fg1;
     font: "Ubuntu 12"; }
window { width: 540px; background-color: @bg1; border: 1px;
          border-color: @bg3; border-radius: 10px; padding: 0; }
mainbox { children: [ inputbar, listview ]; spacing: 0; }
inputbar { children: [ prompt, entry ]; padding: 14px 18px; spacing: 12px;
            border: 0 0 1px 0; border-color: @bg3; }
prompt { text-color: @ac; }
entry { placeholder: "search"; placeholder-color: @dim; vertical-align: 0.5; }
listview { lines: 9; columns: 1; padding: 8px; spacing: 3px;
            scrollbar: false; fixed-height: false; }
element { padding: 9px 14px; spacing: 12px;
           border-radius: 6px; cursor: pointer; }
element normal.normal, element alternate.normal {
  background-color: transparent; text-color: @fg1; }
element normal.active, element alternate.active {
  background-color: transparent; text-color: @ac2; }
element normal.urgent, element alternate.urgent {
  background-color: transparent; text-color: @red; }
element selected.normal, element selected.active {
  background-color: @ac; text-color: @bg; }
element selected.urgent { background-color: @red; text-color: @bg; }
element-icon { size: 20px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
