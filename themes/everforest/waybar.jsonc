// everforest — waybar
// Shell: Desktop readout drawn on the wallpaper (conky) + a slim bottom bar.
// This rice's own desktop shell, not a restyle of another profile's.
{
  "name": "slim",
  "layer": "top",
  "position": "bottom",
  "height": 26,
  "modules-left": [
    "group/workspaces"
  ],
  "modules-center": [],
  "modules-right": [
    "pulseaudio",
    "network",
    "battery",
    "clock"
  ],
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "custom/ws1",
      "custom/ws2",
      "custom/ws3",
      "custom/ws4",
      "custom/ws5"
    ]
  },
  "custom/ws1": {
    "exec": "~/.config/waybar/scripts/ws.py render dots 1",
    "on-click": "~/.config/waybar/scripts/ws.py focus 1",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  },
  "custom/ws2": {
    "exec": "~/.config/waybar/scripts/ws.py render dots 2",
    "on-click": "~/.config/waybar/scripts/ws.py focus 2",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  },
  "custom/ws3": {
    "exec": "~/.config/waybar/scripts/ws.py render dots 3",
    "on-click": "~/.config/waybar/scripts/ws.py focus 3",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  },
  "custom/ws4": {
    "exec": "~/.config/waybar/scripts/ws.py render dots 4",
    "on-click": "~/.config/waybar/scripts/ws.py focus 4",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  },
  "custom/ws5": {
    "exec": "~/.config/waybar/scripts/ws.py render dots 5",
    "on-click": "~/.config/waybar/scripts/ws.py focus 5",
    "return-type": "json",
    "restart-interval": 3,
    "cursor": true
  },
  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-muted": "󰝟",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "󰋋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "interval": 5,
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format-wifi": "<b>{essid}</b>\n{signalStrength}%  ·  {ipaddr}",
    "on-click": "alacritty --class nm-float -e nmtui"
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "{icon} {capacity}",
    "format-charging": "󰂄 {capacity}",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰂂"
    ],
    "tooltip-format": "{capacity}%  ·  {time} left"
  },
  "clock": {
    "interval": 10,
    "format": "{:%H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b>{}</b>"
      }
    }
  },
  "spacing": 5
}
