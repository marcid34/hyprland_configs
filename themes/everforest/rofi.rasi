/* everforest — rofi
 *
 * Warm and unhurried. A raised bg2 panel, soft rounding, and a green
 * selection that is muted enough to read as "current" rather than "alarm".
 */

configuration {
  modes:               "drun,run";
  show-icons:          true;
  icon-theme:          "breeze-dark";
  drun-display-format: "{name}";
  display-drun:        "apps";
  display-run:         "run";
  drun-match-fields:   "name,generic,exec,keywords";
}

* {
  bg0:    #2d353b;
  bg1:    #272e33;
  bg2:    #343f44;
  bg3:    #475258;
  fg:     #d3c6aa;
  grey1:  #859289;
  grey0:  #7a8478;
  green:  #a7c080;
  aqua:   #83c092;
  blue:   #7fbbb3;
  yellow: #dbbc7f;
  red:    #e67e80;

  background-color: transparent;
  text-color:       @fg;
  font:             "Ubuntu 12";
}

window {
  width:            540px;
  background-color: #2d353bf7;
  border:           1px;
  border-color:     @bg3;
  border-radius:    14px;
  padding:          0;
}

mainbox {
  children: [ inputbar, listview ];
  spacing:  0;
}

inputbar {
  children:     [ prompt, entry ];
  padding:      14px 18px;
  spacing:      12px;
  border:       0 0 1px 0;
  border-color: @bg3;
}

prompt {
  background-color: @green;
  text-color:       @bg0;
  padding:          2px 12px;
  border-radius:    8px;
}

entry {
  placeholder:       "search";
  placeholder-color: @grey0;
  cursor:            text;
  text-color:        @fg;
  vertical-align:    0.5;
}

listview {
  lines:        9;
  columns:      1;
  padding:      8px;
  spacing:      3px;
  scrollbar:    false;
  fixed-height: false;
}

element {
  padding:       9px 13px;
  spacing:       12px;
  border-radius: 9px;
  cursor:        pointer;
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color:       @fg;
}

element normal.active,
element alternate.active {
  background-color: transparent;
  text-color:       @aqua;
}

element normal.urgent,
element alternate.urgent {
  background-color: transparent;
  text-color:       @red;
}

element selected.normal,
element selected.active {
  background-color: @green;
  text-color:       @bg0;
}

element selected.urgent {
  background-color: @red;
  text-color:       @bg0;
}

element-icon {
  size:           20px;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color:     inherit;
}
